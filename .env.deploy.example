# Copy this file to .env.deploy.local and fill values.
# .env.deploy.local is gitignored. Do not commit it.

# Deployment CLIs
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Public frontend config
VITE_API_BASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/functions/v1
VITE_SUPABASE_ANON_KEY=
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=

# Server-only function secrets
ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/functions/v1/reddit-oauth/callback
REDDIT_USER_AGENT=SEOAIGrowthEngine/1.0

# Google OAuth / Search Console / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/functions/v1/gsc-oauth/callback
GOOGLE_GSC_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/functions/v1/gsc-oauth/callback
GOOGLE_GMAIL_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/functions/v1/gmail-oauth/callback
