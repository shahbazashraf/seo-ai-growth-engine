# SEO AI Growth Engine - Environment Variables
# Copy to .env.local for local frontend development.
# Add server-only values to your deployed functions provider.

# Frontend app
VITE_API_BASE_URL=

# Firebase Auth / Firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Browser-side AI fallback keys used by the current UI
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=

# Server-only encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Server-only AI keys for functions
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
BLINK_PROJECT_ID=
BLINK_SECRET_KEY=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=
REDDIT_USER_AGENT=SEOAIGrowthEngine/1.0

# Google OAuth / Search Console / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_GSC_REDIRECT_URI=
GOOGLE_GMAIL_REDIRECT_URI=
